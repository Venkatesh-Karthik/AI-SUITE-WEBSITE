# ─────────────────────────────────────────────────────────────
# AI SUITE — Environment configuration
# Copy this file to .env, then fill in every value below.
# Never commit the real .env file.
# ─────────────────────────────────────────────────────────────

# Public URL of the deployed site (no trailing slash).
# Used for OAuth callback URLs and absolute links in emails.
NEXTAUTH_URL="http://localhost:3000"

# Random secret used to sign session/JWT cookies.
# Generate one with: openssl rand -base64 32
NEXTAUTH_SECRET=""

# ── Database (PostgreSQL) ──────────────────────────────────────
# Any Postgres-compatible provider works (Supabase, Neon, Railway, RDS...).
# Must include ?sslmode=require for most managed providers.
DATABASE_URL="postgresql://user:password@host:5432/ai_suite?sslmode=require"

# ── Google OAuth ────────────────────────────────────────────────
# Create credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI must be exactly:
#   ${NEXTAUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ── Email OTP delivery ──────────────────────────────────────────
# This project sends OTP emails via Resend (https://resend.com).
# Swap the implementation in src/lib/email.ts if you prefer another
# provider (Postmark, SES, SendGrid) — nothing else needs to change.
RESEND_API_KEY=""
EMAIL_FROM="AI Suite <login@yourdomain.com>"

# ── Download ─────────────────────────────────────────────────────
# Direct URL to the real Windows installer (Setup.exe).
# Keep this server-side (no NEXT_PUBLIC_ prefix) so it can be swapped,
# access-logged, or put behind signed URLs later without a redeploy.
DOWNLOAD_URL="https://your-cdn.example.com/releases/AI-Suite-Setup.exe"
DOWNLOAD_VERSION="0.1.0"
DOWNLOAD_SIZE_MB=""
DOWNLOAD_RELEASE_DATE=""

# ── Rate limiting (optional, recommended for production) ────────
# If set, OTP rate limiting uses Upstash Redis instead of the
# in-memory fallback (see src/lib/rateLimit.ts). In-memory limiting
# does NOT work correctly across multiple server instances/regions.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
